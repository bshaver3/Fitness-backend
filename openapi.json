            "title": "Type"
          },
          "duration": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Duration"
          },
          "calories": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Calories"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
