            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlannedWorkout": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "default": "default"
          },
          "workout_type": {
            "type": "string",
            "enum": [
              "running",
              "jogging",
              "cycling",
              "swimming",
              "weight training",
              "strength",
              "yoga",
              "hiit",
              "cardio",
              "walking",
              "crossfit",
              "elliptical",
              "hiking",
              "basketball",
              "soccer",
              "tennis",
              "volleyball",
              "dancing",
              "rowing",
              "climbing",
              "boxing",
              "pilates",
              "other"
            ],
            "title": "Workout Type"
          },
          "planned_date": {
            "type": "string",
            "title": "Planned Date"
          },
          "planned_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned Time"
          },
          "planned_duration": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Planned Duration"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed",
            "default": false
          },
          "completed_workout_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed Workout Id"
          }
        },
        "type": "object",
        "required": [
          "workout_type",
          "planned_date",
          "planned_duration"
        ],
        "title": "PlannedWorkout"
      },
      "Profile": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "default": "default"
          },
          "height_feet": {
