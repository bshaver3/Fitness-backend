                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Calories"
          },
          "remaining_calories": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining Calories"
          },
          "over_target_calories": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Over Target Calories"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "date",
          "entries",
          "total_calories",
          "target_calories",
          "status"
        ],
        "title": "DailyFoodSummary"
      },
