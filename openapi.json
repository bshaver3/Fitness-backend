        "type": "object",
        "required": [
          "this_week_workouts",
          "last_week_workouts",
          "this_week_duration",
          "last_week_duration",
          "this_week_calories",
          "last_week_calories",
          "workout_change_percent",
          "duration_change_percent",
          "calories_change_percent"
        ],
        "title": "WeekComparison"
      },
      "WeeklyProgress": {
        "properties": {
          "current": {
            "type": "integer",
            "title": "Current"
          },
          "target": {
            "type": "integer",
            "title": "Target"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "percentage": {
            "type": "number",
            "title": "Percentage"
          }
        },
        "type": "object",
        "required": [
          "current",
          "target",
          "unit",
          "percentage"
        ],
        "title": "WeeklyProgress"
