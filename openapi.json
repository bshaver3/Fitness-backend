      "WorkoutFrequencyPoint": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "date",
          "count"
        ],
        "title": "WorkoutFrequencyPoint"
      },
      "WorkoutTypeBreakdown": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "total_duration": {
            "type": "integer",
            "title": "Total Duration"
          },
          "total_calories": {
            "type": "integer",
            "title": "Total Calories"
          },
          "percentage": {
            "type": "number",
            "title": "Percentage"
          }
        },
        "type": "object",
        "required": [
          "type",
