            "$ref": "#/components/schemas/WeekComparison"
          },
          "streak": {
            "$ref": "#/components/schemas/StreakInfo"
          },
          "workout_frequency": {
            "items": {
              "$ref": "#/components/schemas/WorkoutFrequencyPoint"
            },
            "type": "array",
            "title": "Workout Frequency"
          },
          "calories_over_time": {
            "items": {
              "$ref": "#/components/schemas/CaloriesOverTimePoint"
            },
            "type": "array",
            "title": "Calories Over Time"
          },
          "workout_type_breakdown": {
            "items": {
              "$ref": "#/components/schemas/WorkoutTypeBreakdown"
            },
            "type": "array",
            "title": "Workout Type Breakdown"
          },
          "consistency_stats": {
            "$ref": "#/components/schemas/ConsistencyStats"
          }
        },
        "type": "object",
        "required": [
          "weekly_progress",
          "week_comparison",
          "streak",
          "workout_frequency",
          "calories_over_time",
          "workout_type_breakdown",
          "consistency_stats"
        ],
        "title": "ComprehensiveInsights"
      },
      "ConsistencyStats": {
        "properties": {
          "total_workouts": {
            "type": "integer",
            "title": "Total Workouts"
          },
          "total_duration": {
            "type": "integer",
            "title": "Total Duration"
          },
          "total_calories": {
            "type": "integer",
            "title": "Total Calories"
          },
          "avg_workouts_per_week": {
            "type": "number",
            "title": "Avg Workouts Per Week"
          },
          "avg_duration_per_workout": {
            "type": "number",
            "title": "Avg Duration Per Workout"
          },
          "most_active_day": {
            "type": "string",
            "title": "Most Active Day"
          },
          "favorite_workout_type": {
            "type": "string",
            "title": "Favorite Workout Type"
          }
        },
        "type": "object",
        "required": [
          "total_workouts",
          "total_duration",
          "total_calories",
          "avg_workouts_per_week",
          "avg_duration_per_workout",
          "most_active_day",
          "favorite_workout_type"
        ],
        "title": "ConsistencyStats"
      },
      "DailyFoodSummary": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/FoodEntry"
            },
            "type": "array",
            "title": "Entries"
          },
          "total_calories": {
            "type": "integer",
            "title": "Total Calories"
          },
