          },
          "last_week_workouts": {
            "type": "integer",
            "title": "Last Week Workouts"
          },
          "this_week_duration": {
            "type": "integer",
            "title": "This Week Duration"
          },
          "last_week_duration": {
            "type": "integer",
            "title": "Last Week Duration"
          },
          "this_week_calories": {
            "type": "integer",
            "title": "This Week Calories"
          },
          "last_week_calories": {
            "type": "integer",
            "title": "Last Week Calories"
          },
          "workout_change_percent": {
            "type": "number",
            "title": "Workout Change Percent"
          },
          "duration_change_percent": {
            "type": "number",
            "title": "Duration Change Percent"
          },
          "calories_change_percent": {
            "type": "number",
            "title": "Calories Change Percent"
          }
