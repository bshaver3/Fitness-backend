{
  "components": {
    "schemas": {
      "CaloriesOverTimePoint": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "calories": {
            "type": "integer",
            "title": "Calories"
          }
        },
        "type": "object",
        "required": [
          "date",
          "calories"
        ],
        "title": "CaloriesOverTimePoint"
      },
      "ComprehensiveInsights": {
        "properties": {
          "weekly_progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WeeklyProgress"
              },
              {
                "type": "null"
              }
            ]
          },
          "week_comparison": {
            "$ref": "#/components/schemas/WeekComparison"
          },
          "streak": {
            "$ref": "#/components/schemas/StreakInfo"
          },
          "workout_frequency": {
            "items": {
              "$ref": "#/components/schemas/WorkoutFrequencyPoint"
            },
            "type": "array",
            "title": "Workout Frequency"
          },
          "calories_over_time": {
            "items": {
              "$ref": "#/components/schemas/CaloriesOverTimePoint"
            },
            "type": "array",
            "title": "Calories Over Time"
          },
          "workout_type_breakdown": {
            "items": {
              "$ref": "#/components/schemas/WorkoutTypeBreakdown"
            },
            "type": "array",
            "title": "Workout Type Breakdown"
          },
          "consistency_stats": {
            "$ref": "#/components/schemas/ConsistencyStats"
          }
        },
        "type": "object",
        "required": [
          "weekly_progress",
          "week_comparison",
          "streak",
          "workout_frequency",
          "calories_over_time",
          "workout_type_breakdown",
          "consistency_stats"
        ],
        "title": "ComprehensiveInsights"
      },
      "ConsistencyStats": {
        "properties": {
          "total_workouts": {
            "type": "integer",
            "title": "Total Workouts"
          },
          "total_duration": {
            "type": "integer",
            "title": "Total Duration"
          },
          "total_calories": {
            "type": "integer",
            "title": "Total Calories"
          },
          "avg_workouts_per_week": {
            "type": "number",
            "title": "Avg Workouts Per Week"
          },
          "avg_duration_per_workout": {
            "type": "number",
            "title": "Avg Duration Per Workout"
          },
          "most_active_day": {
            "type": "string",
            "title": "Most Active Day"
          },
          "favorite_workout_type": {
            "type": "string",
            "title": "Favorite Workout Type"
          }
        },
        "type": "object",
        "required": [
          "total_workouts",
          "total_duration",
          "total_calories",
          "avg_workouts_per_week",
          "avg_duration_per_workout",
          "most_active_day",
          "favorite_workout_type"
        ],
        "title": "ConsistencyStats"
      },
      "DailyFoodSummary": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/FoodEntry"
            },
            "type": "array",
            "title": "Entries"
          },
          "total_calories": {
            "type": "integer",
            "title": "Total Calories"
          },
          "target_calories": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Calories"
          },
          "remaining_calories": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining Calories"
          },
          "over_target_calories": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Over Target Calories"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "date",
          "entries",
          "total_calories",
          "target_calories",
          "status"
        ],
        "title": "DailyFoodSummary"
      },
      "FoodEntry": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "calories": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Calories"
          },
          "meal_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meal Type"
          },
          "date": {
            "type": "string",
            "maxLength": 10,
            "minLength": 10,
            "title": "Date"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "calories",
          "date"
        ],
        "title": "FoodEntry"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlannedWorkout": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "default": "default"
          },
          "workout_type": {
            "type": "string",
            "enum": [
              "running",
              "jogging",
              "cycling",
              "swimming",
              "weight training",
              "strength",
              "yoga",
              "hiit",
              "cardio",
              "walking",
              "crossfit",
              "elliptical",
              "hiking",
              "basketball",
              "soccer",
              "tennis",
              "volleyball",
              "dancing",
              "rowing",
              "climbing",
              "boxing",
              "pilates",
              "other"
            ],
            "title": "Workout Type"
          },
          "planned_date": {
            "type": "string",
            "title": "Planned Date"
          },
          "planned_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned Time"
          },
          "planned_duration": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Planned Duration"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed",
            "default": false
          },
          "completed_workout_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed Workout Id"
          }
        },
        "type": "object",
        "required": [
          "workout_type",
          "planned_date",
          "planned_duration"
        ],
        "title": "PlannedWorkout"
      },
      "Profile": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "default": "default"
          },
          "height_feet": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 8.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Height Feet"
          },
          "height_inches": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 11.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Height Inches"
          },
          "current_weight": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000.0,
                "minimum": 50.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Weight"
          },
          "age": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 13.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "sex": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sex"
          },
          "goals": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Goals"
          },
          "target_weight": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000.0,
                "minimum": 50.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Weight"
          },
          "weekly_target_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weekly Target Type"
          },
          "weekly_target_value": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Weekly Target Value"
          },
          "goal_deadline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal Deadline"
          },
          "workout_frequency": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 7.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Workout Frequency"
          },
          "activity_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activity Level"
          },
          "gym_experience": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "beginner",
                  "novice",
                  "intermediate",
                  "advanced",
                  "expert"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Gym Experience"
          },
          "daily_calorie_target": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Calorie Target"
          }
        },
        "type": "object",
        "title": "Profile"
      },
      "StreakInfo": {
        "properties": {
          "current_streak": {
            "type": "integer",
            "title": "Current Streak"
          },
          "longest_streak": {
            "type": "integer",
            "title": "Longest Streak"
          },
          "last_workout_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Workout Date"
          }
        },
        "type": "object",
        "required": [
          "current_streak",
          "longest_streak",
          "last_workout_date"
        ],
