              "running",
              "jogging",
              "cycling",
              "swimming",
              "weight training",
              "strength",
              "yoga",
              "hiit",
              "cardio",
              "walking",
              "crossfit",
              "elliptical",
              "hiking",
              "basketball",
              "soccer",
              "tennis",
              "volleyball",
              "dancing",
              "rowing",
              "climbing",
              "boxing",
              "pilates",
              "other"
